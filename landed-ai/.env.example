# ---------------------------------------------------------------
# LANDED AI — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is ignored by git.
# ---------------------------------------------------------------

# --- Supabase (required) ---
# Supabase dashboard → Project Settings → API Keys.
# The publishable key is safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Site address (recommended in production) ---
# Used to build links in sign-up emails, e.g. https://landed-ai.vercel.app
# Leave empty locally; it is worked out from the request.
NEXT_PUBLIC_SITE_URL=

# --- Claude API (needed from the AI Import Advisor step) ---
# https://console.anthropic.com → API Keys. Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Exchange rates (needed from the Import Analyzer step) ---
# Which provider to use. Leave empty to enter rates manually.
EXCHANGE_RATE_PROVIDER=
# Only if the chosen provider needs a key.
EXCHANGE_RATE_API_KEY=

# --- Official tariff data (future) ---
# Leave empty. No authoritative source is integrated yet, so all customs
# figures are labelled "requires verification".
TARIFF_PROVIDER=
